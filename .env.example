APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=zinusit
DB_USERNAME=zinusit
# DB_PASSWORD=  # REQUIRED - Set in production .env (matches MYSQL_PASSWORD in docker-compose)

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=cache
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# API Keys (Required - set these in production .env file, NOT in .env.example)
# GRAFANA_API_KEY=

# ---------------------------------------------------------------------------
# Snipe-IT API (Required for asset management)
# ---------------------------------------------------------------------------
SNIPEIT_URL=http://snipeit.example.com
# SNIPEIT_TOKEN=  # REQUIRED - Set in production .env
SNIPEIT_CONNECT_TIMEOUT=3
SNIPEIT_TIMEOUT=10

# ---------------------------------------------------------------------------
# LLDAP (SSO Authentication via LDAP)
# Requires php ext-ldap to be enabled on the server (extension=ldap in php.ini)
# ---------------------------------------------------------------------------
LDAP_CONNECTION=default
LDAP_HOST=127.0.0.1
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=com
# Admin bind credentials used for search/create/update operations
LDAP_BIND_DN=uid=admin,ou=people,dc=example,dc=com
# LDAP_BIND_PW=  # REQUIRED - Set in production .env
# Alias for LdapRecord-Laravel config (points to same admin account)
LDAP_USERNAME=uid=admin,ou=people,dc=example,dc=com
# LDAP_PASSWORD=  # REQUIRED - Set in production .env (same as LDAP_BIND_PW)
# OU where user accounts live
LDAP_USERS_OU=ou=people,dc=example,dc=com
LDAP_TIMEOUT=5
LDAP_SSL=false
LDAP_TLS=false
LDAP_CACHE=false

# PRTG Network Monitor (Infrastructure monitoring)
PRTG_URL=https://prtg.example.com
# PRTG_API_TOKEN=  # REQUIRED - Set in production .env
PRTG_AVG_MINUTES=300
PRTG_TIMEOUT=15

# Zabbix Network Monitor (Infrastructure monitoring)
ZABBIX_F1_URL=http://zabbix-f1.example.com/zabbix/api_jsonrpc.php
# ZABBIX_F1_TOKEN=  # REQUIRED - Set in production .env
ZABBIX_TIMEOUT=30
